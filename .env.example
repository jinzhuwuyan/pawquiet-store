# Stripe secret key from https://dashboard.stripe.com/test/apikeys
# Checkout stays closed until this is set. Use a test key (sk_test_...) while you are on the free Stripe test mode.
STRIPE_SECRET_KEY=

# Optional. Hosted Checkout does not read this key. Kept so a later Stripe.js step has a name ready.
STRIPE_PUBLISHABLE_KEY=

# Public site origin, no trailing slash. Success and cancel URLs are built from it.
# Local:  http://127.0.0.1:43123
# Vercel: https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43123
